# En Render se usa un disco persistente montado en /var/data.
NODE_ENV=production
NODE_VERSION=22.20.0
DATABASE_URL=file:/var/data/neurorobi.db
UPLOADS_DIR=/var/data/uploads
SEED_DEMO_DATA=false
# El Blueprint genera JWT_SECRET automaticamente.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_32_CARACTERES_O_MAS
INITIAL_ADMIN_EMAIL=tu-correo@ejemplo.com
INITIAL_ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_NUEVA_DE_12_O_MAS_CARACTERES
