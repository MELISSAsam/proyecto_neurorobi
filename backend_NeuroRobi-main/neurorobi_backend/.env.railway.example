NODE_ENV=production
DATABASE_URL=file:/app/data/neurorobi.db
UPLOADS_DIR=/app/data/uploads
SEED_DEMO_DATA=false
# Necesario para escribir en el volumen montado por Railway con esta imagen.
RAILWAY_RUN_UID=0
# Genera un secreto aleatorio de al menos 32 caracteres; no uses este texto.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
# Solo para el primer arranque; eliminar ambas variables despues de iniciar sesion.
INITIAL_ADMIN_EMAIL=tu-correo@ejemplo.com
INITIAL_ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_NUEVA_DE_12_O_MAS_CARACTERES
