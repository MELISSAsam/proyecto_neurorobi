NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
UPLOADS_DIR=/app/data/uploads
RAILWAY_RUN_UID=0
SEED_DEMO_DATA=false
FRONTEND_URL=https://tu-app.vercel.app
# Genera un secreto aleatorio de al menos 32 caracteres; no uses este texto.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
# Solo para el primer arranque; eliminar ambas variables despues de iniciar sesion.
INITIAL_ADMIN_EMAIL=tu-correo@ejemplo.com
INITIAL_ADMIN_PASSWORD=REEMPLAZAR_POR_UNA_CLAVE_NUEVA_DE_12_O_MAS_CARACTERES

# Genera otra clave aleatoria; el ESP32 debe enviarla en x-device-key.
TELEMETRY_API_KEY=REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO

# Activa las cuentas de la plataforma.
MULTI_USER_ENABLED=true
# Opcional: correo de una cuenta existente que debe tener permisos de superadministrador.
SUPERADMIN_EMAIL=
# Solo se necesita para crear una cuenta SUPERADMINISTRADOR nueva; minimo 12 caracteres.
SUPERADMIN_PASSWORD=
# Compatibilidad con el oso existente y TELEMETRY_API_KEY.
LEGACY_DEVICE_ID=oso-principal
